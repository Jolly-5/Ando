          <string name="Source"><![CDATA[-- src/shared/rovusEventBus.lua
-- Defines a single Replicated event name used by client/server.

local ROVUS_EVENT_BUS = {}

ROVUS_EVENT_BUS.REMOTE_EVENT_NAME = "RovusEventBus"

return ROVUS_EVENT_BUS

